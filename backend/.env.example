# Copie este arquivo para backend/.env e preencha com os dados do banco 
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=
DB_PASSWORD=


# Origens liberadas no CORS (separadas por virgula). Padrao: http://localhost:5173
CORS_ORIGENS=http://localhost:5173

# Supabase Auth: URL do projeto (Project Settings > API). Nao precisa de segredo:
# o token e validado com a chave publica do Supabase.
SUPABASE_URL=https://<projeto>.supabase.co

# E-mails que viram ADMIN ao se cadastrar (separados por virgula)
ADMIN_EMAILS=
